# ==============================================================================
# DAILY LOVE FOR JESUS - MOBILE APP ENVIRONMENT (.env)
# ==============================================================================

# ── 1. Backend API Connection ───────────────────────────────────────────────────
# Base URL to the NestJS Backend server (REST & tRPC)
# - For iOS Simulator / Web: http://localhost:4000
# - For Android Emulator:    http://10.0.2.2:4000
# - For Physical Device on Wi-Fi: http://<your-computer-local-ip>:4000 (e.g. http://192.168.1.15:4000)
# - For Production:          https://api.dailyloveforjesus.org
EXPO_PUBLIC_API_URL=http://localhost:4000

# ── 2. Supabase Authentication ────────────────────────────────────────────────
# Where to find in Supabase:
# Go to https://supabase.com/dashboard -> Select Project -> Project Settings -> API
# Public Project URL:
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Anonymous Public Key (Safe to expose on mobile clients):
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── 3. Bible API Settings ─────────────────────────────────────────────────────
# Default translation to use on fresh app launch (e.g. KJV, WEB, ESV, NIV, NLT)
EXPO_PUBLIC_DEFAULT_BIBLE_TRANSLATION=KJV
