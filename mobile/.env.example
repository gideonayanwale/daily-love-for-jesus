# ==============================================================================
# DAILY LOVE FOR JESUS - MOBILE APP ENVIRONMENT (.env)
# ==============================================================================

# ── Backend Connection ───────────────────────────────────────────────────────
# URL to your deployed or local web/backend server
# For local physical device testing on Wi-Fi, use your local IP: http://192.168.x.x:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# ── Bible API Settings ───────────────────────────────────────────────────────
# Default translation to use on fresh install
EXPO_PUBLIC_DEFAULT_BIBLE_TRANSLATION=KJV
