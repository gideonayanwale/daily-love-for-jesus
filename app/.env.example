# ==============================================================================
# DAILY LOVE FOR JESUS - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# ── 1. Supabase Project Configuration ─────────────────────────────────────────
# Find these in your Supabase Dashboard -> Project Settings -> API
# URL: https://supabase.com/dashboard/project/<your-project-ref>/settings/api

# Public URL of your Supabase project (used by both backend and frontend)
SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon (Public) Key - safe to expose in browsers & mobile clients
SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service Role (Secret) Key - ONLY used on server backend for elevated actions & admin
# NEVER expose this key in the frontend or public git commits!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── 2. Database Connection (Supabase PostgreSQL) ──────────────────────────────
# Find this in Supabase Dashboard -> Project Settings -> Database -> Connection string
# For serverless / connection pooler (recommended):
# postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# ── 3. Application Security ───────────────────────────────────────────────────
APP_ID=daily-love-app
APP_SECRET=your_jwt_signing_secret_here

# ── 4. Admin Role ─────────────────────────────────────────────────────────────
# Set to your Supabase Auth User UUID or Email to automatically grant 'admin' role
ADMIN_USER_ID=
ADMIN_EMAIL=

# ── 5. Bible API Integration (Optional) ───────────────────────────────────────
# Default: Bolls Life API (FREE, 50+ languages, NO key needed!)
# Optional: American Bible Society API.Bible (https://scripture.api.bible/signup)
API_BIBLE_KEY=

# ── 6. Telegram Devotional Channel Sync (Optional) ───────────────────────────
# Used to automatically pull devotionals broadcasted by the ministry
# 1. Talk to @BotFather on Telegram to get your bot token
# 2. Add bot as admin to your church/devotional channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
