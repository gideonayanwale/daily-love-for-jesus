# ==============================================================================
# DAILY LOVE FOR JESUS - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# ── Application & Security Secrets ───────────────────────────────────────────
APP_ID=daily-love-app                 # Application ID for session verification
APP_SECRET=your_jwt_signing_secret    # Application secret (used for JWT signing & session cookies)

# ── Database Connection ──────────────────────────────────────────────────────
# PostgreSQL (Neon/Supabase) or MySQL (PlanetScale/local)
# Example: postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=mysql://user:password@localhost:3306/daily_love

# ── Bible API Integration ────────────────────────────────────────────────────
# Primary Engine: Bolls Life API (FREE, 50+ languages, NO key needed!)
# Secondary / Licensed Engine: American Bible Society API.Bible (Optional)
# Get a free key at: https://scripture.api.bible/signup
API_BIBLE_KEY=

# ── Telegram Devotional Channel Sync (Optional) ──────────────────────────────
# Used to automatically pull devotionals broadcasted by the ministry
# 1. Talk to @BotFather on Telegram to get your bot token
# 2. Add bot as admin to your church/devotional channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# ── Authentication Provider ──────────────────────────────────────────────────
# Default Kimi OAuth / Custom Auth endpoints
VITE_KIMI_AUTH_URL=https://auth.kimi.com
VITE_APP_ID=
KIMI_AUTH_URL=https://auth.kimi.com
KIMI_OPEN_URL=https://open.kimi.com

# ── Admin Access ─────────────────────────────────────────────────────────────
OWNER_UNION_ID=                       # User ID given administrator privileges
