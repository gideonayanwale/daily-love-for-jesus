# ==============================================================================
# DAILY LOVE FOR JESUS - FRONTEND SPA ENVIRONMENT CONFIGURATION (app/.env)
# ==============================================================================
# Variables marked REQUIRED must be set in production.
# Variables marked OPTIONAL have safe defaults for development only.

# ── 0. Backend API Endpoint ───────────────────────────────────────────────────
# In local development: leave blank or set to http://localhost:4000 (Vite proxies /api to port 4000)
# In production (Netlify / Cloudflare Pages): set to your deployed NestJS backend domain
# Example: VITE_API_URL=https://daily-love-backend.up.railway.app
VITE_API_URL=

# ── 1. Supabase Project Configuration ─────────────────────────────────────────
# Find these in your Supabase Dashboard -> Project Settings -> API
# URL: https://supabase.com/dashboard/project/<your-project-ref>/settings/api

# Public URL of your Supabase project (used by both backend and frontend)
SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon (Public) Key - safe to expose in browsers & mobile clients
SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service Role (Secret) Key - ONLY used on server backend for elevated actions & admin
# NEVER expose this key in the frontend or public git commits!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── 2. Database Connection (Supabase PostgreSQL) ──────────────────────────────
# Find this in Supabase Dashboard -> Project Settings -> Database -> Connection string
# For serverless / connection pooler (recommended):
# postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# ── 3. Neon Serverless PostgreSQL (Primary App DB — fast cold starts) ──────────
# 1. Create a free project at https://console.neon.tech
# 2. Go to Dashboard -> Connection Details -> Connection String
# Looks like: postgresql://user:pass@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
# Role: runs all Drizzle ORM queries (reads & writes). Supabase is auth source-of-truth.
NEON_DATABASE_URL=postgresql://neondb_owner:yourpassword@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require


# ── 4. Application Security ───────────────────────────────────────────────────
APP_ID=daily-love-app
# REQUIRED in production — no fallback. Generate with: openssl rand -base64 32
APP_SECRET=your_jwt_signing_secret_here

# ── 5. Admin Role ─────────────────────────────────────────────────────────────
# Roles are assigned through a trusted server/database operation, never by email env vars.

# ── 6. Bible API Integration (Optional) ───────────────────────────────────────
# Default: Bolls Life API (FREE, 50+ languages, NO key needed!)
# Optional: American Bible Society API.Bible (https://scripture.api.bible/signup)
API_BIBLE_KEY=

# ── 7. Telegram Devotional Channel Sync (Optional) ───────────────────────────
# Used to automatically pull devotionals broadcasted by the ministry
# 1. Talk to @BotFather on Telegram to get your bot token
# 2. Add bot as admin to your church/devotional channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Secret token to validate incoming webhook calls from Telegram (set in BotFather setWebhook)
TELEGRAM_WEBHOOK_SECRET=

# ── 8. Cloudinary Media Storage ───────────────────────────────────────────────
# Sign up at https://cloudinary.com and get credentials from Dashboard -> API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
