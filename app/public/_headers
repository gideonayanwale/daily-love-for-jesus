# ==============================================================================
# Daily Love For Jesus - HTTP Response Headers
# Supported natively by Cloudflare Pages & Netlify
# ==============================================================================

# Long-term immutable caching for hashed production assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Ensure index.html and PWA service worker are revalidated
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.json
  Cache-Control: public, max-age=86400

# Security and privacy headers for all routes
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
