# ==============================================================================
# DAILY LOVE FOR JESUS - ROOT ENVIRONMENT TEMPLATE (.env)
# ==============================================================================
# Copy this file to `.env` in the root directory, or to `backend/.env` and `app/.env`
# Detailed secrets walkthrough: see ENV_SETUP.md

# ── Backend Server Settings ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── 1. Supabase Authentication & PostgreSQL ───────────────────────────────────
# Dashboard: https://supabase.com/dashboard/project/<project-ref>/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only: Elevated privileges & bypass RLS
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Supabase direct/pooled connection:
# Dashboard -> Settings -> Database -> Connection String (Port 6543 for pooler)
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# ── 2. Neon Serverless PostgreSQL (Primary App Database) ──────────────────────
# Dashboard: https://console.neon.tech
NEON_DATABASE_URL=postgresql://neondb_owner:yourpassword@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── 3. Application Security ───────────────────────────────────────────────────
APP_ID=daily-love-app
APP_SECRET=your_jwt_signing_secret_here

# ── 4. Admin Privileges ───────────────────────────────────────────────────────
ADMIN_USER_ID=
ADMIN_EMAIL=

# ── 5. Optional Integrations ──────────────────────────────────────────────────
# API.Bible: https://scripture.api.bible/signup
API_BIBLE_KEY=
# Telegram Bot: Message @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
