# ==============================================================================
# DAILY LOVE FOR JESUS - NESTJS BACKEND ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# ── Server Port & Host ────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── 1. Supabase Project Configuration ─────────────────────────────────────────
# Find these in Supabase Dashboard -> Project Settings -> API
# URL: https://supabase.com/dashboard/project/<your-project-ref>/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service Role (Secret) Key - ONLY used on server backend for elevated actions & admin
# NEVER expose this key in the frontend or public git commits!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── 2. Database Connection (Supabase PostgreSQL) ──────────────────────────────
# Find this in Supabase Dashboard -> Project Settings -> Database -> Connection string
# For connection pooler (recommended, Port 6543):
# postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# ── 3. Neon Serverless PostgreSQL (Primary App DB — fast cold starts) ──────────
# 1. Create a free project at https://console.neon.tech
# 2. Go to Dashboard -> Connection Details -> Connection String
# Role: runs all Drizzle ORM queries (reads & writes). Supabase is auth source-of-truth.
NEON_DATABASE_URL=postgresql://neondb_owner:yourpassword@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── 4. Application Security ───────────────────────────────────────────────────
APP_ID=daily-love-app
APP_SECRET=your_jwt_signing_secret_here

# ── 5. Admin Role ─────────────────────────────────────────────────────────────
# Set to your Supabase Auth User UUID or Email to automatically grant 'admin' role
ADMIN_USER_ID=
ADMIN_EMAIL=

# ── 6. Bible API Integration (Optional) ───────────────────────────────────────
# Default: Bolls Life API (FREE, 50+ translations, NO key needed!)
# Optional: American Bible Society API.Bible (https://scripture.api.bible/signup)
API_BIBLE_KEY=

# ── 7. Telegram Devotional Channel Sync (Optional) ───────────────────────────
# Used to automatically pull devotionals broadcasted by the ministry
# 1. Talk to @BotFather on Telegram to get your bot token
# 2. Add bot as admin to your church/devotional channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
